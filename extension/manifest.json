{
  "manifest_version": 3,
  "name": "Job Agent",
  "version": "1.0.0",
  "description": "Auto-fills job application forms using your resume",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Job Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/ats-patterns.js",
        "utils/field-extractor.js",
        "utils/field-filler.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.html", "panel/panel.css", "panel/panel.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
