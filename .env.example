NODE_ENV=development

# ── AI Provider ─────────────────────────────────────────────────────────────
# Pick one provider. Ollama is fully local (no key, no cost).
# Groq and OpenAI are cloud; Groq has a generous free tier — good for a zero-cost demo.

# Local (Ollama) — default for development
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava-phi3

# Cloud — Groq (free tier)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Cloud — OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk_your_key_here
# AI_MODEL=gpt-4o-mini

# ── Form Filling Engine (legacy Playwright path) ─────────────────────────────
# true  → Stagehand agent loop (handles dates, Add buttons, rich text editors)
# false → original HTML-extraction approach (faster for simple forms)
USE_STAGEHAND=true

# ── Browser ──────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=false

# Set to true only when you're confident the form fills correctly
JOB_AGENT_AUTO_SUBMIT=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Supabase (replaces SQLite) ────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # backend only, never expose to frontend

# Google OAuth credentials — paste into Supabase Dashboard (Auth → Providers → Google)
# The app itself doesn't use these directly; Supabase handles the OAuth flow.
# Get them from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# URL of the React frontend (used for CORS)
FRONTEND_URL=http://localhost:5173
