NODE_ENV=development

# ── AI Provider ─────────────────────────────────────────────────────────────
# Pick one provider. Ollama is fully local (no key, no cost).
# Groq and OpenAI are cloud; Groq has a generous free tier — good for a zero-cost demo.

# Local (Ollama) — default for development
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava-phi3

# Cloud — Groq (free tier)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here
# AI_MODEL=llama-3.3-70b-versatile

# Cloud — OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk_your_key_here
# AI_MODEL=gpt-4o-mini

# ── Form Filling Engine (legacy Playwright path) ─────────────────────────────
# true  → Stagehand agent loop (handles dates, Add buttons, rich text editors)
# false → original HTML-extraction approach (faster for simple forms)
USE_STAGEHAND=true

# ── Browser ──────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=false

# Set to true only when you're confident the form fills correctly
JOB_AGENT_AUTO_SUBMIT=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_PATH=./src/data/job-history.db
