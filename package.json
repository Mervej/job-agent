{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development nodemon --watch src --watch .env.dev --ext ts,dev --exec 'node --inspect=9229 -r ts-node/register src/index.ts'",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "axios": "^1.4.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "formidable": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/formidable": "^3.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.2"
  }
}
